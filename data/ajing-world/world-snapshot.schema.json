{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunyou-sifang.local/schema/ajing-world-snapshot-v1.json",
  "title": "阿镜世界快照",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "location", "observations", "events", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "observedAt": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "required": ["id", "name", "latitude", "longitude", "timezone"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": ["string", "null"] },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "timezone": { "type": "string" },
        "modelElevationM": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dimension", "metric", "value", "sourceId", "evidenceMode", "observedAt"],
        "properties": {
          "id": { "type": "string" },
          "dimension": { "type": "string" },
          "metric": { "type": "string" },
          "value": {},
          "unit": { "type": ["string", "null"] },
          "sourceId": { "type": "string" },
          "evidenceMode": { "enum": ["direct", "modelled_observation", "reanalysis", "reported_observation", "calculated", "derived"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "observedAt": { "type": "string" },
          "expiresAt": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "subject", "verb", "title", "evidenceMode", "confidence", "knowledgeMode", "affects", "basisObservationIds"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "subject": { "type": "string" },
          "verb": { "type": "string" },
          "title": { "type": "string" },
          "evidenceMode": { "enum": ["direct", "modelled_observation", "reported_observation", "calculated", "derived"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "knowledgeMode": { "enum": ["direct_experience", "tool_known", "inference_only"] },
          "firstPersonBoundary": { "type": "string" },
          "affects": { "type": "array", "items": { "type": "string" } },
          "basisObservationIds": { "type": "array", "items": { "type": "string" } },
          "expiresAt": { "type": ["string", "null"] },
          "ruleId": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "maintenance": {
      "type": "object",
      "properties": {
        "sourceRegistryVersion": { "type": "string" },
        "inferenceRulesVersion": { "type": "string" },
        "degradedSources": { "type": "array", "items": { "type": "string" } },
        "unconfiguredSources": { "type": "array", "items": { "type": "string" } },
        "disabledSources": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
