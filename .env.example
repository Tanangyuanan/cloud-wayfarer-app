# 云游四方 AI 工具层示例配置。请复制为 .env 或在启动环境中设置，不要提交真实密钥。
CLOUD_WAYFARER_PORT=8787

# 信件、明信片、手账和此刻正文继续使用 DeepSeek V4 Pro。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_FORMAT=openai
AI_ENABLED=true
AI_TEMPERATURE=0.35
AI_REQUEST_TIMEOUT_MS=45000

# DeepSeek 官方 OpenAI 兼容接口；真实密钥只放在本地 .env 或启动环境。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 阿镜的聊天回复固定使用 MiniMax；同一密钥也可用于手账情境图。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# 可选：为聊天回复单独覆盖 MiniMax 配置。不填时复用上面的 MINIMAX_*。
MINIMAX_CHAT_ENABLED=true
MINIMAX_CHAT_API_KEY=
MINIMAX_CHAT_BASE_URL=
MINIMAX_CHAT_MODEL=
MINIMAX_CHAT_TEMPERATURE=0.2
MINIMAX_CHAT_TIMEOUT_MS=45000

# 手账情境图。API 返回的 base64 图片会保存到 data/journeys，不依赖 24 小时临时 URL。
MINIMAX_IMAGE_ENABLED=true
MINIMAX_IMAGE_API_KEY=
MINIMAX_IMAGE_BASE_URL=https://api.minimaxi.com
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_TIMEOUT_MS=90000

# 来信播客。默认使用一位自然的女性声线；可替换为 MiniMax 控制台中的任意 voice_id。
MINIMAX_SPEECH_ENABLED=true
MINIMAX_SPEECH_API_KEY=
MINIMAX_SPEECH_BASE_URL=https://api.minimaxi.com
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_SPEECH_VOICE_ID=Chinese (Mandarin)_News_Anchor
MINIMAX_SPEECH_EMOTION=calm
MINIMAX_SPEECH_SPEED=0.92
MINIMAX_SPEECH_TIMEOUT_MS=120000

# 外部搜索按 Tavily -> Brave -> Serper -> Wikipedia 公共检索自动降级。
SEARCH_ENABLED=true
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
ALLOW_PUBLIC_SEARCH=true

# 天气使用 Open-Meteo，无需密钥。设为 false 可完全关闭外部天气请求。
WEATHER_ENABLED=true
AIR_QUALITY_ENABLED=true

# 阿镜公开世界数据。除 NASA FIRMS 外均可无密钥运行；OpenSky 认证为可选，可提高额度。
WORLD_PUBLIC_DATA_ENABLED=true
WORLD_PUBLIC_TIMEOUT_MS=8000
WORLD_PUBLIC_SLOW_TIMEOUT_MS=15000
WORLD_HISTORY_YEARS=10
WORLD_BIODIVERSITY_RADIUS_KM=25
WORLD_EARTHQUAKE_RADIUS_KM=300
WORLD_FIRE_RADIUS_KM=100
WORLD_AVIATION_RADIUS_KM=100
NASA_FIRMS_MAP_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
